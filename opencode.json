{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "./.opencode/plugins/ccgs-hooks.ts",
    "./.opencode/plugins/drift-detector.ts",
    "./.opencode/plugins/changelog-generator.ts"
  ],
  "command": {
    "hybrid-prototype": {
      "template": "Run the hybrid-prototype skill: load .agents/skills/hybrid-prototype/SKILL.md and follow the fast-lane prototype workflow. Concept: $ARGUMENTS",
      "description": "Fast-lane prototype for discovery phase — build a playable prototype in 2-3 days with minimal process overhead.",
      "agent": "prototyper"
    }
  },
  "mcp": {
    "aseprite": {
      "type": "local",
      "command": ["uv", "--directory", "tools/aseprite-mcp", "run", "-m", "aseprite_mcp"],
      "enabled": true,
      "environment": {
        "ASEPRITE_PATH": "{env:ASEPRITE_PATH}"
      }
    },
    "beckett": {
      "type": "local",
      "url": "http://127.0.0.1:8770/mcp",
      "enabled": false
    },
    "blender": {
      "type": "local",
      "command": ["uvx", "--from", "git+https://projects.blender.org/lab/blender_mcp.git#subdirectory=mcp", "blender-mcp"],
      "enabled": true,
      "environment": {
        "BLENDER_MCP_HOST": "10.0.2.2",
        "BLENDER_MCP_PORT": "9876"
      }
    },
    "unity": {
      "type": "local",
      "url": "http://localhost:8080/mcp",
      "enabled": false
    }
  },
  "permission": {
    "bash": {
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "ls *": "allow",
      "dir *": "allow",
      "python -m json.tool*": "allow",
      "python -m pytest*": "allow",
      "py -m pytest*": "allow",
      "rm -rf *": "deny",
      "git push --force*": "deny",
      "git push -f *": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "sudo *": "deny",
      "chmod 777*": "deny",
      "*>.env*": "deny",
      "cat *.env*": "deny",
      "type *.env*": "deny"
    },
    "read": {
      "**/.env*": "deny"
    }
  }
}
